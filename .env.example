RIOT_API_KEY="RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Neon connection string. Use the pooled ("-pooler") connection string from your Neon
# project dashboard — required because Next.js dev/serverless spins up many short-lived
# connections and Postgres itself caps concurrent connections.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
